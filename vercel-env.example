# -----------------------------------------------------------------------------
# Vercel Environment Variables Reference
# Set ALL of these in the Vercel dashboard:
#   Project → Settings → Environment Variables
# -----------------------------------------------------------------------------

# -- Database (Supabase) -------------------------------------------------------
# Your Supabase project → Settings → Database → Connection string (URI mode)
# Use the "pooled" connection string (port 6543) for serverless functions.
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:6543/<DATABASE>?pgbouncer=true

# -- Auth ----------------------------------------------------------------------
JWT_SECRET=<generate a long random string, e.g. openssl rand -hex 64>
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# -- CORS ----------------------------------------------------------------------
# Set this to your production Vercel domain.
CORS_ORIGIN=https://affy-food-bank-czt6.vercel.app

# -- TransactPay Payment Gateway (https://merchant.transactpay.ai) -------------
# All 4 keys are REQUIRED for live payments to work:
#   PUBLIC_KEY  = used in API request headers (api-key)
#   SECRET_KEY  = same as API_KEY, used for server-side verification
#   API_KEY     = same as SECRET_KEY (duplicate for compatibility)
#   ENCRYPTION_KEY = 4096-bit RSA XML public key (base64) for payload encryption
TRANSACTPAY_PUBLIC_KEY=PGW-PUBLICKEY-493151248075433389622408C227C1E2
TRANSACTPAY_SECRET_KEY=PGW-SECRETKEY-620CFCCDDDFC4D06B002F0E2598E2F21
TRANSACTPAY_API_KEY=PGW-SECRETKEY-620CFCCDDDFC4D06B002F0E2598E2F21
TRANSACTPAY_ENCRYPTION_KEY=NDA5NiE8UlNBS2V5VmFsdWU+...

# -- TransactPay Webhook -------------------------------------------------------
# Register this URL in your TransactPay merchant dashboard:
# https://affy-food-bank-czt6.vercel.app/api/v1/payments/transactpay/webhook

# -- Resend Email Service (https://resend.com) ---------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Affy FoodBank <noreply@affyfoodbank.com.ng>
ADMIN_EMAIL=affybrand@gmail.com
