// prisma/schema.prisma
// Synced schema for root and Vercel build runners

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Core Identity
// =====================
model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rolePermissions RolePermission[]
  users       User[]
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  action      String
  resource    String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rolePermissions RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role        @relation(fields: [roleId], references: [id])
  permission   Permission  @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  isActive     Boolean   @default(true)
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      CustomerProfile?
  deliveries   Delivery[]
  auditLogs    AuditLog[]
  adpOperators AdpOperator[]
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses              Address[]
  wallet                 Wallet?
  savingsPlans           SavingsPlan[]
  orders                 Order[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  walletTransactions     WalletTransaction[] @relation("ProfileTransactions")
  virtualAccount         VirtualAccount?
  fundingEvents          WalletFundingEvent[]
}

model Address {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  line1             String
  line2             String?
  city              String
  state             String
  postalCode        String?
  country           String
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id])
  deliveries      Delivery[]
}

// =====================
// Marketplace
// =====================
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  symbol    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  packageItems  PackageItem[]
  savingsPlanItems SavingsPlanItem[]
  orderItems    OrderItem[]
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sku         String? @unique
  priceCents  BigInt   @default(0)
  currency    String   @default("NGN")
  imageUrl    String?
  unitId      String?
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        Unit?    @relation(fields: [unitId], references: [id])
  category    Category?@relation(fields: [categoryId], references: [id])
  inventory   Inventory?
  packageItems PackageItem[]
  savingsPlanItems SavingsPlanItem[]
  orderItems  OrderItem[]
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique
  quantity  Decimal  @default(0)
  lowStockThreshold Decimal @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id])
}

model Package {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PackageItem[]
}

model PackageItem {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String
  productId String
  quantity  Decimal
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package   Package @relation(fields: [packageId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  unit      Unit    @relation(fields: [unitId], references: [id])

  @@unique([packageId, productId, unitId])
}

// =====================
// Financial Ledger
// =====================
model Wallet {
  id                         String   @id @default(uuid()) @db.Uuid
  customerProfileId          String   @unique
  totalBalanceCents          BigInt   @default(0)
  allocatedToSavingsCents    BigInt   @default(0)
  reservedWithdrawalCents    BigInt   @default(0)
  currency                   String   @default("NGN")
  status                     String   @default("ACTIVE")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  customerProfile            CustomerProfile @relation(fields: [customerProfileId], references: [id])
  transactions               WalletTransaction[]
  orders                     Order[]
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SAVINGS_ALLOCATION
  SAVINGS_RELEASE
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum TransactionDirection {
  IN
  OUT
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

model WalletTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  walletId          String
  customerId        String
  reference         String   @unique
  providerSessionId String?
  providerReference String?
  type              TransactionType
  amountCents       BigInt
  grossAmountCents  BigInt?
  feeCents          BigInt?           @default(0)
  currency          String            @default("NGN")
  direction         TransactionDirection
  status            TransactionStatus @default(PENDING)
  description       String?
  paymentReference  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  wallet        Wallet          @relation(fields: [walletId], references: [id])
  customerProfile CustomerProfile @relation("ProfileTransactions", fields: [customerId], references: [id])
  contributions SavingsContribution[]
}

// =====================
// Savings Plans
// =====================
enum SavingsStatus {
  DRAFT
  ACTIVE
  TARGET_REACHED
  PURCHASE_CONFIRMED
  COMPLETED
  CANCELLED
}

model SavingsPlan {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  name              String
  description       String?
  targetAmountCents BigInt
  amountSavedCents  BigInt   @default(0)
  targetDate        DateTime
  status            SavingsStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  items             SavingsPlanItem[]
  contributions     SavingsContribution[]
}

model SavingsPlanItem {
  id             String   @id @default(uuid()) @db.Uuid
  savingsPlanId  String
  productId      String
  quantity       Decimal
  unitId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  savingsPlan    SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  product        Product @relation(fields: [productId], references: [id])
  unit           Unit @relation(fields: [unitId], references: [id])

  @@unique([savingsPlanId, productId, unitId])
}

model SavingsContribution {
  id                 String   @id @default(uuid()) @db.Uuid
  savingsPlanId      String
  walletTransactionId String
  amountCents        BigInt
  createdAt          DateTime @default(now())

  savingsPlan        SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  walletTransaction  WalletTransaction @relation(fields: [walletTransactionId], references: [id])
}

// =====================
// Orders & Logistics
// =====================
enum OrderStatus {
  PENDING
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model Order {
  id               String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  walletId         String?
  totalAmountCents BigInt
  currency         String   @default("NGN")
  status           OrderStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  wallet            Wallet? @relation(fields: [walletId], references: [id])
  items             OrderItem[]
  delivery          Delivery?
  adpOperatorId     String?      @db.Uuid
  adpSnapshot       Json?
  adpOperator       AdpOperator? @relation(fields: [adpOperatorId], references: [id])
  adpEarning        AdpEarning?
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Delivery {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @unique
  driverUserId       String?
  addressId          String?
  status             DeliveryStatus @default(PENDING)
  proofOfDeliveryUrl String?
  notes              String?
  estimatedDeliveryAt DateTime?
  actualDeliveryAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order              Order @relation(fields: [orderId], references: [id])
  driverUser         User? @relation(fields: [driverUserId], references: [id])
  address            Address? @relation(fields: [addressId], references: [id])
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String
  productId         String
  quantity          Decimal
  unitId            String
  priceAtPurchaseCents BigInt
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order   Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  unit    Unit @relation(fields: [unitId], references: [id])
}

// =====================
// Notifications
// =====================
model Notification {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  type              String
  title             String
  message           String
  isRead            Boolean @default(false)
  createdAt         DateTime @default(now())

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
}

model NotificationPreference {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String @unique
  channel           String
  frequency         String @default("DAILY")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
}

// =====================
// Audit Logs
// =====================
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?
  action      String
  targetTable String?
  targetId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String? // store as text; could be Inet if needed
  createdAt   DateTime @default(now())

  user        User? @relation(fields: [userId], references: [id])
}

// =====================
// OTP Verifications (Durable Storage)
// =====================
model OtpVerification {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  hashedOtp   String
  purpose     String    @default("LOGIN")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  resendAfter DateTime
  consumedAt  DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
}

// =====================
// Delivery Fee Configuration
// =====================
model DeliveryFeeConfig {
  id                         String   @id @default(uuid()) @db.Uuid
  standardFeeCents           BigInt   @default(150000)
  freeDeliveryThresholdCents BigInt   @default(5000000)
  expressFeeCents            BigInt   @default(250000)
  stateFees                  Json
  isActive                   Boolean  @default(true)
  updatedBy                  String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// =====================
// Virtual Accounts (TransactPay Dedicated Funding Accounts)
// =====================
model VirtualAccount {
  id                String          @id @default(uuid()) @db.Uuid
  customerProfileId String          @unique
  accountNumber     String          @unique @db.VarChar(20)
  bankName          String          @db.VarChar(100)
  bankCode          String?         @db.VarChar(20)
  accountName       String          @db.VarChar(150)
  accountReference  String          @unique @db.VarChar(100)
  alias             String?         @unique @db.VarChar(100)
  currency          String          @default("NGN") @db.VarChar(5)
  provider          String          @default("TRANSACTPAY") @db.VarChar(50)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
}

// =====================
// Wallet Funding Events (Durable Webhook & Independent Verification)
// =====================
enum FundingEventStatus {
  RECEIVED
  VERIFYING
  CREDITED
  FAILED
  UNMATCHED
  REJECTED
}

model WalletFundingEvent {
  id                       String             @id @default(uuid()) @db.Uuid
  sessionId                String             @unique @db.VarChar(150)
  paymentReference         String             @unique @db.VarChar(150)
  accountReference         String?            @db.VarChar(150)
  destinationAccountNumber String?            @db.VarChar(30)
  customerProfileId        String?
  rawPayload               Json
  status                   FundingEventStatus @default(RECEIVED)
  grossAmountCents         BigInt?
  feeCents                 BigInt?            @default(0)
  netAmountCents           BigInt?
  currency                 String             @default("NGN") @db.VarChar(5)
  verifiedAt               DateTime?
  verificationPayload      Json?
  failureReason            String?
  attempts                 Int                @default(0)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  customerProfile          CustomerProfile?   @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
}

// =====================
// Coverage Zones & Affy's Delivery Ports (ADP)
// =====================
model CoverageZone {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(100)
  normalizedName String   @unique @db.VarChar(100)
  targetAdpCount Int      @default(2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operators      AdpOperator[]
  rates          AdpCompensationRate[]
  earnings       AdpEarning[]
}

model AdpOperator {
  id                        String   @id @default(uuid()) @db.Uuid
  applicationReference      String   @unique @db.VarChar(50)
  userId                    String   @db.Uuid
  coverageZoneId            String   @db.Uuid
  fullName                  String   @db.VarChar(150)
  matricNumber              String   @db.VarChar(50)
  normalizedMatric          String   @db.VarChar(50)
  institution               String   @default("University of Ilesa (UNILESA)") @db.VarChar(150)
  faculty                   String   @db.VarChar(100)
  department                String   @db.VarChar(100)
  academicLevel             String   @db.VarChar(20)
  phone                     String   @db.VarChar(20)
  email                     String   @db.VarChar(150)
  studentIdDocPath          String   @db.Text
  hostelName                String   @db.VarChar(150)
  hostelAddress             String   @db.Text
  closestLandmark           String?  @db.VarChar(150)
  bankName                  String   @db.VarChar(100)
  bankCode                  String   @db.VarChar(20)
  accountNumberEncrypted    String   @db.Text
  accountNumberMasked       String   @db.VarChar(20)
  accountName               String   @db.VarChar(150)
  nameEnquiryVerifiedName   String?  @db.VarChar(150)
  alternativeContact        String?  @db.VarChar(50)
  status                    String   @default("PENDING_REVIEW") @db.VarChar(50)
  studentVerificationStatus String   @default("PENDING") @db.VarChar(50)
  studentVerificationNotes  String?  @db.Text
  studentVerifiedBy         String?  @db.Uuid
  studentVerifiedAt         DateTime?
  hostelVerificationStatus  String   @default("PENDING") @db.VarChar(50)
  hostelVerificationNotes   String?  @db.Text
  hostelVerifiedBy          String?  @db.Uuid
  hostelVerifiedAt          DateTime?
  paymentVerificationStatus String   @default("PENDING") @db.VarChar(50)
  paymentVerificationNotes  String?  @db.Text
  paymentVerifiedBy         String?  @db.Uuid
  paymentVerifiedAt         DateTime?
  isActive                  Boolean  @default(false)
  rejectionReason           String?  @db.Text
  suspensionReason          String?  @db.Text
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user                      User                 @relation(fields: [userId], references: [id])
  coverageZone              CoverageZone         @relation(fields: [coverageZoneId], references: [id])
  histories                 AdpVerificationHistory[]
  earnings                  AdpEarning[]
  payoutBatches             AdpPayoutBatch[]
  orders                    Order[]
}

model AdpVerificationHistory {
  id            String   @id @default(uuid()) @db.Uuid
  adpOperatorId String   @db.Uuid
  track         String   @db.VarChar(50)
  oldStatus     String   @db.VarChar(50)
  newStatus     String   @db.VarChar(50)
  reason        String?  @db.Text
  officerUserId String?  @db.Uuid
  createdAt     DateTime @default(now())

  adpOperator   AdpOperator @relation(fields: [adpOperatorId], references: [id], onDelete: Cascade)
}

model AdpCompensationRate {
  id                     String   @id @default(uuid()) @db.Uuid
  coverageZoneId         String?  @db.Uuid
  ratePerCollectionCents BigInt
  effectiveFrom          DateTime @default(now())
  isActive               Boolean  @default(true)
  createdBy              String?  @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  coverageZone           CoverageZone? @relation(fields: [coverageZoneId], references: [id], onDelete: Cascade)
}

model AdpEarning {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @unique @db.Uuid
  adpOperatorId  String   @db.Uuid
  amountCents    BigInt
  rateUsedCents  BigInt
  coverageZoneId String   @db.Uuid
  status         String   @default("PENDING") @db.VarChar(50)
  payoutBatchId  String?  @db.Uuid
  collectedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order          Order          @relation(fields: [orderId], references: [id])
  adpOperator    AdpOperator    @relation(fields: [adpOperatorId], references: [id])
  coverageZone   CoverageZone   @relation(fields: [coverageZoneId], references: [id])
  payoutBatch    AdpPayoutBatch? @relation(fields: [payoutBatchId], references: [id])
}

model AdpPayoutBatch {
  id               String   @id @default(uuid()) @db.Uuid
  batchReference   String   @unique @db.VarChar(50)
  adpOperatorId    String   @db.Uuid
  totalAmountCents BigInt
  earningsCount    Int
  status           String   @default("PENDING") @db.VarChar(50)
  channel          String   @default("MANUAL") @db.VarChar(50)
  clientReference  String?  @unique @db.VarChar(100)
  paymentReference String?  @db.VarChar(100)
  processedBy      String?  @db.Uuid
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  adpOperator      AdpOperator  @relation(fields: [adpOperatorId], references: [id])
  earnings         AdpEarning[]
}



