// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: uuid-ossp extension is enabled via the SQL migration (001_initial_schema.sql)

// =====================
// Core Identity
// =====================
model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rolePermissions RolePermission[]
  users       User[]
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  action      String
  resource    String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  rolePermissions RolePermission[]

  @@unique([action, resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role        @relation(fields: [roleId], references: [id])
  permission   Permission  @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  isActive     Boolean   @default(true)
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      CustomerProfile?
  deliveries   Delivery[]
  auditLogs    AuditLog[]
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses              Address[]
  wallet                 Wallet?
  savingsPlans           SavingsPlan[]
  orders                 Order[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  walletTransactions     WalletTransaction[] @relation("ProfileTransactions")
}

model Address {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  line1             String
  line2             String?
  city              String
  state             String
  postalCode        String?
  country           String
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id])
  deliveries      Delivery[]
}

// =====================
// Marketplace
// =====================
model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  symbol    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  packageItems  PackageItem[]
  savingsPlanItems SavingsPlanItem[]
  orderItems    OrderItem[]
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  sku         String? @unique
  priceCents  BigInt   @default(0)
  currency    String   @default("NGN")
  imageUrl    String?
  unitId      String?
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit        Unit?    @relation(fields: [unitId], references: [id])
  category    Category?@relation(fields: [categoryId], references: [id])
  inventory   Inventory?
  packageItems PackageItem[]
  savingsPlanItems SavingsPlanItem[]
  orderItems  OrderItem[]
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique
  quantity  Decimal  @default(0)
  lowStockThreshold Decimal @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product @relation(fields: [productId], references: [id])
}

model Package {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items PackageItem[]
}

model PackageItem {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String
  productId String
  quantity  Decimal
  unitId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  package   Package @relation(fields: [packageId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  unit      Unit    @relation(fields: [unitId], references: [id])

  @@unique([packageId, productId, unitId])
}

// =====================
// Financial Ledger
// =====================
model Wallet {
  id                         String   @id @default(uuid()) @db.Uuid
  customerProfileId          String   @unique
  totalBalanceCents          BigInt   @default(0)
  allocatedToSavingsCents    BigInt   @default(0)
  currency                   String   @default("NGN")
  status                     String   @default("ACTIVE")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  customerProfile            CustomerProfile @relation(fields: [customerProfileId], references: [id])
  transactions               WalletTransaction[]
  orders                     Order[]
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SAVINGS_ALLOCATION
  SAVINGS_RELEASE
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum TransactionDirection {
  IN
  OUT
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}

model WalletTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  walletId         String
  customerId       String
  reference        String   @unique
  type             TransactionType
  amountCents      BigInt
  currency         String   @default("NGN")
  direction        TransactionDirection
  status           TransactionStatus @default(PENDING)
  description      String?
  paymentReference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wallet        Wallet          @relation(fields: [walletId], references: [id])
  customerProfile CustomerProfile @relation("ProfileTransactions", fields: [customerId], references: [id])
  contributions SavingsContribution[]
}

// =====================
// Savings Plans
// =====================
enum SavingsStatus {
  DRAFT
  ACTIVE
  TARGET_REACHED
  PURCHASE_CONFIRMED
  COMPLETED
  CANCELLED
}

model SavingsPlan {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  name              String
  description       String?
  targetAmountCents BigInt
  amountSavedCents  BigInt   @default(0)
  targetDate        DateTime
  status            SavingsStatus @default(DRAFT)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  items             SavingsPlanItem[]
  contributions     SavingsContribution[]
}

model SavingsPlanItem {
  id             String   @id @default(uuid()) @db.Uuid
  savingsPlanId  String
  productId      String
  quantity       Decimal
  unitId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  savingsPlan    SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  product        Product @relation(fields: [productId], references: [id])
  unit           Unit @relation(fields: [unitId], references: [id])

  @@unique([savingsPlanId, productId, unitId])
}

model SavingsContribution {
  id                 String   @id @default(uuid()) @db.Uuid
  savingsPlanId      String
  walletTransactionId String
  amountCents        BigInt
  createdAt          DateTime @default(now())

  savingsPlan        SavingsPlan @relation(fields: [savingsPlanId], references: [id])
  walletTransaction  WalletTransaction @relation(fields: [walletTransactionId], references: [id])
}

// =====================
// Orders & Logistics
// =====================
enum OrderStatus {
  PENDING
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model Order {
  id               String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  walletId         String?
  totalAmountCents BigInt
  currency         String   @default("NGN")
  status           OrderStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  wallet            Wallet? @relation(fields: [walletId], references: [id])
  items             OrderItem[]
  delivery          Delivery?
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  READY_FOR_DISPATCH
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Delivery {
  id                 String   @id @default(uuid()) @db.Uuid
  orderId            String   @unique
  driverUserId       String?
  addressId          String?
  status             DeliveryStatus @default(PENDING)
  proofOfDeliveryUrl String?
  notes              String?
  estimatedDeliveryAt DateTime?
  actualDeliveryAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order              Order @relation(fields: [orderId], references: [id])
  driverUser         User? @relation(fields: [driverUserId], references: [id])
  address            Address? @relation(fields: [addressId], references: [id])
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String
  productId         String
  quantity          Decimal
  unitId            String
  priceAtPurchaseCents BigInt
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order   Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  unit    Unit @relation(fields: [unitId], references: [id])
}

// =====================
// Notifications
// =====================
model Notification {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String
  type              String
  title             String
  message           String
  isRead            Boolean @default(false)
  createdAt         DateTime @default(now())

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
}

model NotificationPreference {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String @unique
  channel           String
  frequency         String @default("DAILY")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
}

// =====================
// Audit Logs
// =====================
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?
  action      String
  targetTable String?
  targetId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String? // store as text; could be Inet if needed
  createdAt   DateTime @default(now())

  user        User? @relation(fields: [userId], references: [id])
}
